{
    "type": "drupal-drush",
    "name": "drupal/marvin_phpunit_incubator",
    "description": "Drush commands to manage contrib development",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "drupal",
        "drush",
        "marvin"
    ],
    "authors": [
        {
            "name": "Andor",
            "role": "Maintainer",
            "homepage": "https://github.com/Sweetchuck"
        }
    ],
    "homepage": "https://drupal.org/project/marvin_phpunit_incubator",
    "support": {
        "issues": "https://www.drupal.org/project/issues/marvin_phpunit_incubator",
        "source": "https://git.drupalcode.org/project/marvin_phpunit_incubator"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-json": "*",
        "drupal/marvin": "4.x-dev",
        "drupal/marvin_incubator": "4.x-dev",
        "drupal/marvin_phpunit": "3.x-dev",
        "sweetchuck/robo-phpunit": "4.x-dev",
        "sweetchuck/env-var-storage": "1.x-dev",
        "sweetchuck/utils": "2.x-dev"
    },
    "require-dev": {
        "drush/drush": "^13.0",
        "mikey179/vfsstream": "^1.6",
        "symfony/finder": "^6.0",
        "weitzman/drupal-test-traits": "^2.1"
    },
    "suggest": {
        "drush/drush": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Drush\\Commands\\marvin_phpunit_incubator\\": "Commands/marvin_phpunit_incubator/",
            "Drupal\\marvin_phpunit_incubator\\": "src/"
        }
    },
    "extra": {
        "drush": {
            "services": {
                "drush.services.yml": "*"
            }
        }
    }
}
